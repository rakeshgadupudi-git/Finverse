{
  "outputDirectory": "frontend/dist",
  "rewrites": [
    { "source": "/api/auth/:path*", "destination": "https://fintracker-auth-service.onrender.com/api/auth/:path*" },
    { "source": "/api/user/:path*", "destination": "https://fintracker-auth-service.onrender.com/api/user/:path*" },
    { "source": "/api/portfolio/:path*", "destination": "https://fintracker-auth-service.onrender.com/api/portfolio/:path*" },
    { "source": "/api/transactions/:path*", "destination": "https://fintracker-auth-service.onrender.com/api/transactions/:path*" },
    { "source": "/api/watchlist/:path*", "destination": "https://fintracker-auth-service.onrender.com/api/watchlist/:path*" },
    { "source": "/api/alerts/:path*", "destination": "https://fintracker-auth-service.onrender.com/api/alerts/:path*" },
    { "source": "/api/tax/:path*", "destination": "https://fintracker-auth-service.onrender.com/api/tax/:path*" },
    { "source": "/api/goals/:path*", "destination": "https://fintracker-auth-service.onrender.com/api/goals/:path*" },
    { "source": "/api/bills/:path*", "destination": "https://fintracker-auth-service.onrender.com/api/bills/:path*" },
    { "source": "/api/notifications/:path*", "destination": "https://fintracker-auth-service.onrender.com/api/notifications/:path*" },
    { "source": "/api/planned-payments/:path*", "destination": "https://fintracker-auth-service.onrender.com/api/planned-payments/:path*" },
    { "source": "/api/shopping-lists/:path*", "destination": "https://fintracker-auth-service.onrender.com/api/shopping-lists/:path*" },
    { "source": "/api/warranties/:path*", "destination": "https://fintracker-auth-service.onrender.com/api/warranties/:path*" },
    { "source": "/api/loyalty-cards/:path*", "destination": "https://fintracker-auth-service.onrender.com/api/loyalty-cards/:path*" },
    { "source": "/api/debts/:path*", "destination": "https://fintracker-auth-service.onrender.com/api/debts/:path*" },
    { "source": "/api/accounts/:path*", "destination": "https://fintracker-auth-service.onrender.com/api/accounts/:path*" },
    { "source": "/api/:path*", "destination": "https://fintracker-api-service.onrender.com/api/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
